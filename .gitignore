# Godot-generated state
.godot/
.mono/

# Local exports and builds. Keep the marker that tells Godot not to import
# generated captures, automation profiles, and other build artifacts.
build/*
!build/.gdignore
exports/

# Unreviewed asset-pack scouting shelf
incoming/

# Imported DCC/editor state
*.blend1
*.blend2
*.tmp
*.bak
resources/level_layouts/*.lock/

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

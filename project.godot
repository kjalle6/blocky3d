; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Blocky 3D"
run/main_scene="res://scenes/app/game_root.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

GameProgression="*res://scripts/progression/progression_store.gd"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Blocky 3D"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp_toolkit/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

